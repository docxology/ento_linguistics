  --output OUTPUT       Output file path (default: data/corpus/abstracts.json)
  --stats-output STATS_OUTPUT
                        Stats output file path (default:
                        output/data/corpus_statistics.json)
  --force               Re-fetch the base queries and merge into the existing
                        corpus (dedupe by PMID + text key; existing records
                        are never dropped)
  --grow                Grow the corpus by running mine_corpus_growth over all
                        CORPUS_GROWTH_QUERIES and appending new unique records
  --target-new TARGET_NEW
                        With --grow: stop once this many new records were
                        collected (default: 1000)
  --since-pdat SINCE_PDAT
                        With --grow: PubMed date window lower bound, e.g.
                        2020/01/01

