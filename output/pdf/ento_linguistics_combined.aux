\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cross-domain comparison of terminology characteristics across all six Ento-Linguistic domains. The six panels show (top-left) the number of distinct terms extracted per domain, (top-right) the average confidence score assigned during extraction, (center-left) cumulative term frequency across the corpus, (center-right) the mean semantic entropy $H(t)$ per domain, (bottom-left) cross-domain bridging term counts, and (bottom-right) the mean CACE aggregate score. Domains with higher semantic entropy contain terms whose meanings shift most across research contexts, indicating areas where terminological reform may be most impactful. All panel values are computed at runtime from \colorbox {codebg}{\color  {codefg}\ttfamily  output/data/domain\_statistics.json}.}}{52}{figure.caption.6}\protected@file@percent }
\newlabel{fig:domain_comparison}{{4}{52}{Cross-domain comparison of terminology characteristics across all six Ento-Linguistic domains. The six panels show (top-left) the number of distinct terms extracted per domain, (top-right) the average confidence score assigned during extraction, (center-left) cumulative term frequency across the corpus, (center-right) the mean semantic entropy $H(t)$ per domain, (bottom-left) cross-domain bridging term counts, and (bottom-right) the mean CACE aggregate score. Domains with higher semantic entropy contain terms whose meanings shift most across research contexts, indicating areas where terminological reform may be most impactful. All panel values are computed at runtime from \texttt {output/data/domain\_statistics.json}}{figure.caption.6}{}}
\newlabel{fig:domain_comparison@cref}{{[figure][4][]4}{[1][14][]52}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Anthropomorphic framing prevalence across Ento-Linguistic domains. The trajectory highlights paradigm shifts across decades, showcasing how domains like Power \& Labor experienced steep declines in overt anthropomorphism—consistent with the formal "slave" terminology reforms documented in Section \ref {sec:discussion}—while economic framing concurrently rose to prominence.}}{53}{figure.caption.7}\protected@file@percent }
\newlabel{fig:anthropomorphic}{{5}{53}{Anthropomorphic framing prevalence across Ento-Linguistic domains. The trajectory highlights paradigm shifts across decades, showcasing how domains like Power \& Labor experienced steep declines in overt anthropomorphism—consistent with the formal "slave" terminology reforms documented in Section \ref {sec:discussion}—while economic framing concurrently rose to prominence}{figure.caption.7}{}}
