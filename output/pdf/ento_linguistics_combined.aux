\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Pairwise Welch's $t$-tests on per-term semantic entropy between Ento-Linguistic domains, with Benjamini-Hochberg adjusted $p$-values (benjamini_hochberg correction over 15 comparisons) and Cohen's $d$ effect sizes. The Sig.\ (BH) column reports BH-adjusted significance at $q = 0.05$ for each comparison. Domain descriptives feeding these tests are per-term valid-entropy means with exclusions counted. The omnibus one-way ANOVA across the six domains on semantic_entropy yields $F(5.0000, 264.0000) = 0.3771$, 0.8642, $\miteta ^2 = 0.0071$, where $df_1 = k - 1$ (between-group) and $df_2 = N - k$ (within-group).}}{46}{table.caption.15}\protected@file@percent }
\newlabel{tab:pairwise_domain}{{2}{46}{Pairwise Welch's $t$-tests on per-term semantic entropy between Ento-Linguistic domains, with Benjamini-Hochberg adjusted $p$-values (benjamini_hochberg correction over 15 comparisons) and Cohen's $d$ effect sizes. The Sig.\ (BH) column reports BH-adjusted significance at $q = 0.05$ for each comparison. Domain descriptives feeding these tests are per-term valid-entropy means with exclusions counted. The omnibus one-way ANOVA across the six domains on semantic_entropy yields $F(5.0000, 264.0000) = 0.3771$, 0.8642, $\eta ^2 = 0.0071$, where $df_1 = k - 1$ (between-group) and $df_2 = N - k$ (within-group)}{table.caption.15}{}}
\newlabel{tab:pairwise_domain@cref}{{[table][2][]2}{[1][46][]46}{}{}{}}
